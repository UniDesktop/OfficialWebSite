---
import '../styles/home.css';
import Icon from '../components/Icon.astro';
import { Code } from 'astro:components';

const codeTheme = {
  name: 'unidesktop',
  type: 'dark' as const,
  colors: { 'editor.background': 'var(--color-code-surface)', 'editor.foreground': 'var(--color-code-text)' },
  tokenColors: [
    { scope: ['keyword', 'storage'], settings: { foreground: 'var(--color-code-keyword)' } },
    { scope: ['string'], settings: { foreground: 'var(--color-code-string)' } },
    { scope: ['entity.name.function', 'support.function'], settings: { foreground: 'var(--color-code-function)' } },
    { scope: ['entity.name.type', 'support.type', 'constant'], settings: { foreground: 'var(--color-code-type)' } },
    { scope: ['comment'], settings: { foreground: 'var(--color-code-muted)' } },
  ],
};

const repo = 'https://github.com/UniDesktop/SDK';
const features = [
  { icon: 'appearance' as const, title: '主题与外观', text: '检测明暗主题，实时跟随系统外观。' },
  { icon: 'wallpaper' as const, title: '壁纸管理', text: '支持多显示器、填充模式与明暗配对。' },
  { icon: 'notification' as const, title: '原生通知', text: '发送系统通知，支持操作按钮与优先级。' },
  { icon: 'wake' as const, title: '保持唤醒', text: '按需阻止显示器休眠或系统空闲。' },
];
const examples = [
  { id: 'rust', title: 'Rust', note: 'Linux 主题检测示例 · 平台实现通过统一 trait 接入', code: `use uda_core::appearance::AppearanceManager;
use uda_platform_linux::appearance::LinuxAppearanceManager;

fn main() -> Result<(), uda_core::error::UdaError> {
    let desktop = LinuxAppearanceManager::new();
    let theme = desktop.detect_theme()?;
    println!("System theme: {theme:?}");
    Ok(())
}`, href: `${repo}#rust` },
  { id: 'python', title: 'Python', note: '使用仓库内的 ctypes 包装器，先构建 uda-ffi', code: `from uda import Uda, FillMode

with Uda() as desktop:
    theme = desktop.detect_theme()
    print(f"System theme: {theme}")

    desktop.set_wallpaper(
        "/usr/share/backgrounds/wallpaper.jpg",
        FillMode.FIT
    )`, href: `${repo}/tree/main/examples/python` },
  { id: 'node', title: 'Node.js', note: '使用 koffi 访问 C ABI · Windows 动态库示例', code: `const koffi = require('koffi');
const lib = koffi.load(process.env.UDA_LIBRARY ?? 'uda_ffi.dll');

const detectTheme = lib.func(
  'uda_detect_theme', 'int32', ['void *']
);
const theme = koffi.alloc(koffi.types.int32, 1);
if (detectTheme(theme) === 0) {
  console.log(koffi.decode(theme, koffi.types.int32));
}`, href: `${repo}/tree/main/examples/nodejs` },
];
const platforms = [
  ['Windows 10 / 11', '原生 Win32 / WinRT', true],
  ['GNOME 42+', 'Portal / 桌面接口', true],
  ['KDE Plasma 5 / 6', 'Portal / 桌面接口', true],
  ['XFCE', '桌面接口 / 回退后端', true],
  ['Hyprland / Sway', 'Wayland / 可用后端', false],
  ['Generic X11', 'CLI 回退后端', false],
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="UniDesktop 为 Windows 和 Linux 桌面提供统一、类型安全的 Rust API。一次接入主题检测、壁纸管理、原生通知和保持唤醒能力。" />
    <meta name="theme-color" content="#f4f6f8" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('unidesktop-theme') === 'dark' ? 'dark' : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <meta property="og:title" content="UniDesktop — 统一桌面接口，专注应用本身" />
    <meta property="og:description" content="连接应用与桌面的开源基础设施。统一接口，原生能力，开放共建。" />
    <meta property="og:type" content="website" />
    <title>UniDesktop — 统一桌面接口，专注应用本身</title>
    <link rel="icon" href="/unidesktop-logo.png" type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到主要内容</a>
    <header class="site-header">
      <div class="container nav-inner">
        <a class="brand" href="/" aria-label="UniDesktop 首页"><img src="/unidesktop-logo.png" width="40" height="34" alt="" /><span>UniDesktop<span class="brand-dot">.</span></span></a>
        <nav id="main-nav" aria-label="主导航">
          <a href="#capabilities">核心能力</a><a href="#platforms">平台支持</a><a href="/zh-cn/">开发文档</a><a href="#community">社区</a>
        </nav>
        <div class="nav-actions">
          <button class="theme-toggle" type="button" aria-label="暗黑主题" aria-pressed="false" title="切换为深色主题">
            <svg class="theme-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" /></svg>
            <svg class="theme-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M5 19l1.5-1.5M17.5 6.5 19 5" /></svg>
          </button>
          <a class="github-link" href="https://github.com/UniDesktop" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a><a class="button button-small" href="/zh-cn/getting-started/installation/">开始接入 <span aria-hidden="true">→</span></a><button class="menu-toggle" aria-label="打开导航菜单" aria-controls="main-nav" aria-expanded="false"><span></span><span></span></button>
        </div>
      </div>
    </header>
    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy">
          <a class="project-label" href={repo} target="_blank" rel="noreferrer">开源的跨平台桌面集成 SDK <span aria-hidden="true">↗</span></a>
          <h1 id="hero-title">统一桌面接口，<br /><span>专注应用本身。</span></h1>
          <p class="hero-description">一套 Rust API，连接 Windows 与 Linux。<br />让主题、壁纸、通知与唤醒能力更容易接入。</p>
          <div class="hero-actions"><a class="button" href="/zh-cn/getting-started/installation/">开始构建 <span aria-hidden="true">→</span></a><a class="button button-outline" href={repo} target="_blank" rel="noreferrer"><span class="code-mark" aria-hidden="true">&lt;/&gt;</span> 探索源代码</a></div>
        </div>
        <figure class="architecture" aria-label="架构示意：桌面应用通过 UniDesktop API 连接 Windows 和 Linux 桌面环境">
          <div class="diagram-top"><span>你的应用</span><span>跨语言接入</span></div>
          <div class="app-languages"><span>Rust</span><span>Python</span><span>Node.js</span><span>C / C++</span></div>
          <svg class="connector connector-top" viewBox="0 0 400 48" preserveAspectRatio="none" aria-hidden="true"><path class="trace trace-feeds" pathLength="100" d="M50 0V12Q50 24 62 24H338Q350 24 350 12V0" /><path class="trace trace-inner" pathLength="100" d="M150 0V24M250 0V24" /><path class="trace trace-stem" pathLength="100" d="M200 24V48" /><circle cx="200" cy="24" r="3" /></svg>
          <div class="api-node">
            <div class="api-identity"><img src="/unidesktop-logo.png" width="76" height="64" alt="" /><div><strong>UniDesktop API</strong><span>一个接口，连接不同桌面。</span></div></div>
            <div class="api-contract"><span>Rust crates</span><span>C ABI</span><span>统一能力契约</span></div>
          </div>
          <svg class="connector connector-bottom" viewBox="0 0 400 48" preserveAspectRatio="none" aria-hidden="true"><path class="trace trace-out" pathLength="100" d="M200 0V24" /><path class="trace trace-split" pathLength="100" d="M100 48V36Q100 24 112 24H288Q300 24 300 36V48" /><circle cx="200" cy="24" r="3" /></svg>
          <div class="desktop-nodes"><div><strong>Windows</strong><small>Win32 / WinRT</small></div><div><strong>Linux</strong><small>Portal / D-Bus / CLI</small></div></div>
          <figcaption><span aria-hidden="true">↳</span> 按运行环境，选择可用的原生后端。</figcaption>
        </figure>
      </section>

      <div class="platform-strip container" aria-label="覆盖的桌面环境"><span>连接你熟悉的桌面</span><div><b>Windows</b><b>GNOME</b><b>KDE <span>Plasma</span></b><b>XFCE</b><b>Hyprland</b><b>Sway</b></div><a href="#platforms">查看支持范围 <span aria-hidden="true">↗</span></a></div>

      <section class="capabilities container section" id="capabilities" aria-labelledby="capabilities-title">
        <div class="section-heading"><div><h2 id="capabilities-title">常用能力，统一接入。</h2></div></div>
        <div class="feature-grid">{features.map((feature) => <article class="feature"><div class="feature-top"><span class="feature-icon" aria-hidden="true"><Icon name={feature.icon} /></span></div><h3>{feature.title}</h3><p>{feature.text}</p></article>)}</div>
      </section>

      <section class="integration" id="get-started" aria-labelledby="integration-title">
        <div class="container integration-inner"><div class="integration-copy"><h2 id="integration-title">从一段代码开始。</h2><p>使用 Rust 原生接口，或通过 C ABI<br />接入 Python 与 Node.js。</p><a class="text-link" href="/zh-cn/getting-started/installation/">阅读接入指南 <span aria-hidden="true">→</span></a><div class="source-note"><span>从源码开始</span><p>当前通过仓库构建 SDK。<br />公开 Releases 暂无预编译安装包。</p><a href={`${repo}/archive/refs/heads/main.zip`}>下载源码 ZIP <span aria-hidden="true">↓</span></a></div></div>
          <div class="code-demo">
            <div class="code-toolbar">
              <div class="code-tabs" role="tablist" aria-label="示例语言">{examples.map((example, index) => <button role="tab" id={`tab-${example.id}`} aria-controls={`panel-${example.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-language={example.id}>{example.title}</button>)}</div>
              <button class="copy-button" aria-label="复制当前代码示例">复制代码</button>
            </div>
            {examples.map((example, index) => (
              <div id={`panel-${example.id}`} role="tabpanel" aria-labelledby={`tab-${example.id}`} hidden={index !== 0}>
                <Code code={example.code} lang={example.id === 'node' ? 'javascript' : example.id === 'python' ? 'python' : 'rust'} theme={codeTheme} tabindex="0" aria-label={`${example.title} 代码示例，可横向滚动`} />
                <div class="code-note"><a href={example.href} target="_blank" rel="noreferrer">完整示例 ↗</a></div>
              </div>
            ))}
            <span class="sr-only" aria-live="polite" id="copy-status"></span>
          </div>
        </div>
      </section>

      <section class="platforms container section" id="platforms" aria-labelledby="platforms-title"><div class="section-heading"><div><h2 id="platforms-title">支持哪些桌面？</h2></div></div><div class="support-layout"><div class="support-principle"><div class="cascade"><span>XDG Portal</span><i>↓</i><span>桌面原生 IPC</span><i>↓</i><span>CLI 回退</span><i>↓</i><code>Unsupported</code></div><h3>可预期的逐级回退</h3><p>通过 <code>capabilities()</code> 区分完整支持、受限支持与不支持，让应用在调用之前就能做出判断。</p></div><div class="support-table-wrap"><table class="support-table"><caption class="sr-only">依据 SDK README 的桌面环境支持范围</caption><thead><tr><th scope="col">桌面环境</th><th scope="col">接入方式</th><th scope="col">核心能力</th></tr></thead><tbody>{platforms.map(([name, backend, full]) => <tr><th scope="row">{name}</th><td>{backend}</td><td><span class:list={['support-status', { full }]}>{full ? '✓ 完整支持' : '◒ 部分支持'}</span></td></tr>)}</tbody></table><p class="table-note">完整支持指主题、壁纸、通知和唤醒四项能力。部分支持环境的壁纸能力可用，其余能力依赖运行环境及回退后端。</p><a class="text-link" href="/zh-cn/reference/platform-support/">查看详细兼容性说明 <span aria-hidden="true">→</span></a></div></div></section>

      <section class="community container" id="community" aria-labelledby="community-title"><div><h2 id="community-title">一起完善桌面生态。</h2><p>由 SR Studio 发起，与开源社区共同维护。<br />欢迎贡献代码、反馈问题，或支持项目。</p><a class="button" href={`${repo}/discussions`} target="_blank" rel="noreferrer">参与社区讨论 <span aria-hidden="true">↗</span></a></div><div class="community-links"><a href={`${repo}/issues`} target="_blank" rel="noreferrer"><span><strong>反馈问题</strong><small>报告问题，分享你的桌面环境与使用场景</small></span><span aria-hidden="true">↗</span></a><a href={repo} target="_blank" rel="noreferrer"><span><strong>贡献代码</strong><small>完善平台适配、文档与多语言示例</small></span><span aria-hidden="true">↗</span></a><a href="https://afdian.com/a/srinternet" target="_blank" rel="noreferrer"><span><strong>赞助项目</strong><small>帮助社区采购开发硬件与维护 CI 服务器</small></span><span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="site-footer container"><div class="footer-main"><a class="brand" href="/"><img src="/unidesktop-logo.png" width="32" height="28" alt="" /><span>UniDesktop<span class="brand-dot">.</span></span></a><span>不同桌面，共同语言。</span><div><a href="/zh-cn/">文档</a><a href="https://github.com/UniDesktop" target="_blank" rel="noreferrer">GitHub ↗</a><a href="mailto:UniDesktop@sr-studio.cn">联系我们</a></div></div><div class="footer-meta"><span>© {new Date().getFullYear()} UniDesktop Community</span><span>由 <a href="https://github.com/SRInternet-Studio/" target="_blank" rel="noreferrer">SR Studio</a> 发起 · 与开源社区共同维护</span><a href={`${repo}/blob/main/LICENSE-APACHE`} target="_blank" rel="noreferrer">SDK · MIT / Apache-2.0</a></div></footer>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      function applyTheme(theme: 'light' | 'dark') {
        document.documentElement.dataset.theme = theme;
        themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
        themeToggle.title = theme === 'dark' ? '切换为浅色主题' : '切换为深色主题';
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(document.documentElement).getPropertyValue('--color-paper').trim());
      }
      applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      themeToggle.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(theme);
        try { localStorage.setItem('unidesktop-theme', theme); } catch { /* The current-page toggle also works without browser storage. */ }
      });
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const nav = document.querySelector<HTMLElement>('#main-nav')!;
      const closeMenu = () => { menu.setAttribute('aria-expanded', 'false'); menu.setAttribute('aria-label', '打开导航菜单'); nav.classList.remove('is-open'); };
      menu.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); menu.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单'); nav.classList.toggle('is-open', open); });
      nav.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) closeMenu(); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && menu.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); } });
      document.addEventListener('click', (event) => { if (!(event.target as HTMLElement).closest('.nav-inner')) closeMenu(); });
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const copyButton = document.querySelector<HTMLButtonElement>('.copy-button')!;
      const copyStatus = document.querySelector<HTMLElement>('#copy-status')!;
      let resetCopy: ReturnType<typeof setTimeout>;
      let panelTimer: ReturnType<typeof setTimeout> | undefined;

      /* Motion is opt-in. Every animation on this page is authored so the default
       * rendering is the finished state; JS only adds the class that starts it.
       * That keeps the page correct when JS fails, and — because the existing
       * reduced-motion block switches every animation off with !important — it
       * keeps reveal-style animations from leaving content permanently hidden. */
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      // Swap panels with a short fade-out / fade-in rather than an instant jump.
      function showPanel(current: HTMLElement | null, next: HTMLElement) {
        clearTimeout(panelTimer);
        if (!current || current === next || prefersReducedMotion.matches) {
          if (current && current !== next) current.hidden = true;
          next.hidden = false;
          return;
        }
        current.dataset.leaving = '';
        panelTimer = setTimeout(() => {
          delete current.dataset.leaving;
          current.hidden = true;
          next.hidden = false;
          next.dataset.entering = '';
          panelTimer = setTimeout(() => { delete next.dataset.entering; }, 260);
        }, 120);
      }

      function selectTab(tab: HTMLButtonElement) {
        // Selection state is immediate; only the panel content crossfades.
        tabs.forEach((item) => { const selected = item === tab; item.setAttribute('aria-selected', String(selected)); item.tabIndex = selected ? 0 : -1; });
        clearTimeout(resetCopy); copyButton.textContent = '复制代码'; copyStatus.textContent = '';
        showPanel(document.querySelector<HTMLElement>('[role="tabpanel"]:not([hidden])'), document.getElementById(tab.getAttribute('aria-controls')!)!);
      }
      tabs.forEach((tab, index) => { tab.addEventListener('click', () => selectTab(tab)); tab.addEventListener('keydown', (event) => { let next = index; if (event.key === 'ArrowRight') next = (index + 1) % tabs.length; else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length; else if (event.key === 'Home') next = 0; else if (event.key === 'End') next = tabs.length - 1; else return; event.preventDefault(); selectTab(tabs[next]); tabs[next].focus(); }); });
      copyButton.addEventListener('click', async () => {
        copyButton.disabled = true;
        try { await navigator.clipboard.writeText(document.querySelector('[role="tabpanel"]:not([hidden]) code')!.textContent!); copyButton.textContent = '已复制 ✓'; copyStatus.textContent = '代码已复制到剪贴板'; }
        catch { copyButton.textContent = '请手动复制'; copyStatus.textContent = '浏览器未允许剪贴板访问，请选中代码手动复制。'; }
        finally { copyButton.disabled = false; clearTimeout(resetCopy); resetCopy = setTimeout(() => { copyButton.textContent = '复制代码'; }, 2500); }
      });

      /* Motion 1 — hero architecture trace.
       * Plays once on load: the four language hosts feed the rail, the call
       * descends through the API contract, and both desktops light together.
       * The class is removed afterwards so the stylesheet returns to its plain
       * state even if an animation never ran. */
      const architecture = document.querySelector<HTMLElement>('.architecture');
      if (architecture && !prefersReducedMotion.matches) {
        architecture.classList.add('motion-arch');
        setTimeout(() => architecture.classList.remove('motion-arch'), 2200);
      }

      /* Motion 2 — fallback cascade probe.
       * Fires once when the principle card scrolls into view, showing the tiers
       * being walked in order. It only marks the order, never the outcome, so it
       * cannot misrepresent which backend answers on a given machine. */
      const cascade = document.querySelector<HTMLElement>('.support-principle');
      if (cascade && !prefersReducedMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('motion-cascade');
            observer.unobserve(entry.target);
            setTimeout(() => entry.target.classList.remove('motion-cascade'), 1400);
          }
        }, { threshold: 0.35 });
        observer.observe(cascade);
      }
    </script>
  </body>
</html>
