---
/* HERO 变体 A · 可交互架构图
 *
 * 右侧架构图保留，但把两个平台从静态卡片换成真实按钮：选中一个平台，
 * 下方展开它实际命中的后端链。链上的每一条都来自 docs/reference/platform-support
 * 与 internals 分区，不是示意文案。
 *
 * 自带动效与样式，切换变体时不会留下孤儿 CSS。
 */
interface Props { repo: string }
const { repo } = Astro.props;

const chains = {
  windows: {
    label: 'Windows',
    sub: 'Win32 / WinRT',
    rows: [
      ['主题检测', '注册表 AppsUseLightTheme'],
      ['壁纸', 'SystemParametersInfoW'],
      ['通知', 'Windows Toast'],
      ['托盘', 'Shell_NotifyIconW'],
    ],
  },
  linux: {
    label: 'Linux',
    sub: 'Portal / D-Bus / CLI',
    rows: [
      ['主题检测', 'XDG Portal → gsettings'],
      ['壁纸', 'gsettings · plasmashell → feh / swww'],
      ['通知', 'org.freedesktop.Notifications'],
      ['托盘', 'StatusNotifierItem + DBusMenu'],
    ],
  },
} as const;
---
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <a class="project-label" href={repo} target="_blank" rel="noreferrer">开源的跨平台桌面集成 SDK <span aria-hidden="true">↗</span></a>
    <h1 id="hero-title">两个桌面，<br /><span>一套代码。</span></h1>
    <p class="hero-description">Windows 与 Linux 的桌面差异，收进一套类型安全的 Rust API。<br />点开右侧平台，看它真实命中的后端。</p>
    <div class="hero-actions"><a class="button" href="/zh-cn/getting-started/installation/">开始构建 <span aria-hidden="true">→</span></a><a class="button button-outline" href={repo} target="_blank" rel="noreferrer"><span class="code-mark" aria-hidden="true">&lt;/&gt;</span> 探索源代码</a></div>
  </div>

  <figure class="architecture" aria-label="架构示意：桌面应用通过 UniDesktop API 连接 Windows 和 Linux，选择平台可查看实际后端">
    <div class="diagram-top"><span>你的应用</span><span>跨语言接入</span></div>
    <div class="app-languages"><span>Rust</span><span>Python</span><span>Node.js</span><span>C / C++</span></div>
    <svg class="connector connector-top" viewBox="0 0 400 48" preserveAspectRatio="none" aria-hidden="true"><path class="trace trace-feeds" pathLength="100" d="M50 0V12Q50 24 62 24H338Q350 24 350 12V0" /><path class="trace trace-inner" pathLength="100" d="M150 0V24M250 0V24" /><path class="trace trace-stem" pathLength="100" d="M200 24V48" /><circle cx="200" cy="24" r="3" /></svg>
    <div class="api-node">
      <div class="api-identity"><img src="/unidesktop-logo.png" width="76" height="64" alt="" /><div><strong>UniDesktop API</strong><span>一个接口，连接不同桌面。</span></div></div>
      <div class="api-contract"><span>Rust crates</span><span>C ABI</span><span>统一能力契约</span></div>
    </div>
    <svg class="connector connector-bottom" viewBox="0 0 400 48" preserveAspectRatio="none" aria-hidden="true"><path class="trace trace-out" pathLength="100" d="M200 0V24" /><path class="trace trace-split" pathLength="100" d="M100 48V36Q100 24 112 24H288Q300 24 300 36V48" /><circle cx="200" cy="24" r="3" /></svg>

    <div class="platform-tabs" role="group" aria-label="选择平台查看后端">
      {Object.entries(chains).map(([key, chain], index) => (
        <button type="button" class="platform-tab" data-platform={key} aria-pressed={index === 0 ? 'true' : 'false'}>
          <strong>{chain.label}</strong><small>{chain.sub}</small>
        </button>
      ))}
    </div>

    <div class="arch-detail" aria-live="polite">
      {Object.entries(chains).map(([key, chain], index) => (
        <dl class="arch-chain" data-chain={key} hidden={index !== 0}>
          <dt class="sr-only">{chain.label} 后端</dt>
          {chain.rows.map(([ability, backend]) => (
            <div class="arch-row"><span>{ability}</span><code>{backend}</code></div>
          ))}
        </dl>
      ))}
    </div>

    <figcaption><span aria-hidden="true">↳</span> 每条链都按运行环境逐级回退，不可用时报类型化错误。</figcaption>
  </figure>
</section>

<style is:global>
  .platform-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .platform-tab {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    padding: 12px; border: var(--rule); border-radius: var(--radius-xs);
    background: var(--color-surface); color: var(--color-ink);
    transition: border-color var(--dur-micro) var(--ease-out), background var(--dur-micro) var(--ease-out);
  }
  .platform-tab strong { font-family: var(--font-display); font-size: 15px; font-weight: 600; }
  .platform-tab small { font-size: 10px; color: var(--color-muted); white-space: nowrap; }
  .platform-tab[aria-pressed='true'] { border-color: var(--color-accent); background: var(--color-tint); }
  .platform-tab[aria-pressed='true'] small { color: var(--color-accent); }
  @media (hover: hover) { .platform-tab:hover { border-color: var(--color-accent); } }

  .arch-detail { margin-top: 14px; border-top: var(--rule); padding-top: 12px; }
  .arch-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 5px 0; font-size: 11px; }
  .arch-row > span { color: var(--color-muted); white-space: nowrap; }
  .arch-row > code { font-size: 11px; color: var(--color-ink); text-align: right; }

  /* Motion: the chain for the newly selected platform settles in. One shot per
   * switch, never a loop. Guarded by no-preference so the reduced-motion block
   * in home.css can never leave a row stuck at opacity 0. */
  @media (prefers-reduced-motion: no-preference) {
    .arch-chain[data-entering] .arch-row {
      opacity: 0;
      animation: arch-row-in var(--dur-short) var(--ease-out) forwards;
    }
    .arch-chain[data-entering] .arch-row:nth-child(2) { animation-delay: 40ms; }
    .arch-chain[data-entering] .arch-row:nth-child(3) { animation-delay: 80ms; }
    .arch-chain[data-entering] .arch-row:nth-child(4) { animation-delay: 120ms; }
    .arch-chain[data-entering] .arch-row:nth-child(5) { animation-delay: 160ms; }
  }
  @keyframes arch-row-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  /* Hero architecture trace — same sequence as the baseline, kept here so this
   * variant is self-contained. */
  @media (prefers-reduced-motion: no-preference) {
    .motion-arch .diagram-top { opacity: 0; animation: arch-fade var(--dur-short) var(--ease-out) forwards; }
    .motion-arch .app-languages span { opacity: 0; animation: arch-rise var(--dur-short) var(--ease-out) forwards; }
    .motion-arch .app-languages span:nth-child(1) { animation-delay: 80ms; }
    .motion-arch .app-languages span:nth-child(2) { animation-delay: 110ms; }
    .motion-arch .app-languages span:nth-child(3) { animation-delay: 140ms; }
    .motion-arch .app-languages span:nth-child(4) { animation-delay: 170ms; }
    .motion-arch .connector .trace {
      stroke-dasharray: 100 100; stroke-dashoffset: 100;
      animation: arch-draw var(--dur-short) var(--ease-out) forwards;
    }
    .motion-arch .connector .trace-feeds,
    .motion-arch .connector .trace-inner { animation-duration: var(--dur-long); animation-delay: 360ms; }
    .motion-arch .connector .trace-stem { animation-delay: 780ms; }
    .motion-arch .connector .trace-out { animation-delay: 1200ms; }
    .motion-arch .connector .trace-split { animation-delay: 1420ms; }
    .motion-arch .connector circle { opacity: 0; animation: arch-fade var(--dur-micro) var(--ease-out) forwards; }
    .motion-arch .connector-top circle { animation-delay: 760ms; }
    .motion-arch .connector-bottom circle { animation-delay: 1400ms; }
    .motion-arch .api-contract > span { opacity: 0; animation: arch-fade var(--dur-short) var(--ease-out) forwards; animation-delay: 980ms; }
    .motion-arch .platform-tab { animation: arch-wake var(--dur-short) var(--ease-out); animation-delay: 1620ms; }
  }
  @keyframes arch-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes arch-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes arch-draw { to { stroke-dashoffset: 0; } }
  @keyframes arch-wake {
    0%, 100% { border-color: var(--color-rule); background: var(--color-surface); }
    40% { border-color: var(--color-accent); background: var(--color-tint); }
  }
</style>

<script>
  /* Platform switcher. Selection state updates immediately; only the chain
   * body animates, and only when motion is allowed. */
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.platform-tab')];
  const chains = [...document.querySelectorAll<HTMLElement>('.arch-chain')];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let timer: ReturnType<typeof setTimeout> | undefined;

  function select(key: string) {
    tabs.forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.platform === key)));
    clearTimeout(timer);
    chains.forEach((chain) => {
      const active = chain.dataset.chain === key;
      if (active && chain.hidden) {
        chain.hidden = false;
        if (!reduced.matches) {
          chain.dataset.entering = '';
          timer = setTimeout(() => delete chain.dataset.entering, 600);
        }
      } else if (!active) {
        chain.hidden = true;
        delete chain.dataset.entering;
      }
    });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(tab.dataset.platform!));
    tab.addEventListener('keydown', (event) => {
      let next = index;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
      else return;
      event.preventDefault();
      select(tabs[next].dataset.platform!);
      tabs[next].focus();
    });
  });
</script>
